      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  // Se obtiene el prompt devuelto por Gemini\n  const rawPrompt = item.json.text || '';\n  \n  // Limpia saltos de línea y espacios dobles\n  const cleanPrompt = rawPrompt.replace(/[\\r\\n]+/g, ' ').trim();\n  \n  // Codifica la cadena para incluirla de forma segura en una URL\n  item.json.prompt_encoded = encodeURIComponent(cleanPrompt);\n}\n\nreturn $input.all();"
      },
