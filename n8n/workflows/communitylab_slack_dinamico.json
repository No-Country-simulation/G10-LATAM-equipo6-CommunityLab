      "id": "sk-respond-challenge",
      "name": "Responder Challenge Slack"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analiza la siguiente interaccion recibida en Slack de la comunidad:\n\nUsuario: {{ $json.body.event.user || 'Usuario Slack' }}\nCanal: {{ $json.body.event.channel || 'general' }}\nTexto: \"{{ $json.body.event.text }}\"\n\nInstrucciones:\n1. Clasifica el sentimiento (positivo, neutro, negativo).\n2. Determina el tipo_contenido (logro_contratacion, duda_tecnica, showcase, feedback_general).\n3. Extrae temas_clave tecnologicos.\n4. Si es logro_contratacion o showcase, redacta un post_linkedin inspirador.\n5. Si es duda_tecnica, redacta un tip_tecnico_faq estructurado.\n6. Redacta una respuesta_chat clara, amable y ejecutiva para responder en Slack.",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=Eres el asistente oficial de CommunityLab en Slack (Oracle Next Education & Alura). Ayudas a resolver dudas, celebrar logros y consolidar activos tecnicos."
            }
          ]
        }
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        260,
        340
      ],
      "id": "sk-chain-001",
      "name": "Procesador IA Slack"
    },
    {
      "parameters": {
        "model": "llama-3.3-70b-versatile",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        180,
        560
      ],
      "id": "sk-model-001",
      "name": "Groq Chat Model",
      "credentials": {
        "groqApi": {
          "id": "dAfNMioPwJHVr5V2",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"CommunityLabSlackOutput\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"sentimiento\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"positivo\",\n        \"neutro\",\n        \"negativo\"\n      ]\n    },\n    \"tipo_contenido\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"logro_contratacion\",\n        \"duda_tecnica\",\n        \"feedback_general\",\n        \"showcase\"\n      ]\n    },\n    \"temas_clave\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"respuesta_chat\": {\n      \"type\": \"string\"\n    },\n    \"post_linkedin\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"tip_tecnico_faq\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    }\n  },\n  \"required\": [\n    \"sentimiento\",\n    \"tipo_contenido\",\n    \"temas_clave\",\n    \"respuesta_chat\"\n  ]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        360,
        560
      ],
      "id": "sk-parser-001",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "// Construir Slack Blocks para respuesta estructurada en hilo\nconst output = $json.output || $json;\nconst slackEvent = $('Slack Events Webhook').item.json.body.event || {};\n\nconst sentimientoBadge = output.sentimiento === 'positivo' ? ':large_green_circle: Positivo' : (output.sentimiento === 'negativo' ? ':red_circle: Negativo' : ':large_yellow_circle: Neutro');\n\nconst blocks = [\n  {\n    \"type\": \"header\",\n    \"text\": {\n      \"type\": \"plain_text\",\n      \"text\": \"\ud83e\udd16 CommunityLab Assistant\",\n      \"emoji\": true\n    }\n  },\n  {\n    \"type\": \"section\",\n    \"text\": {\n      \"type\": \"mrkdwn\",\n      \"text\": output.respuesta_chat || \"\u00a1Mensaje procesado correctamente!\"\n    }\n  },\n  {\n    \"type\": \"context\",\n    \"elements\": [\n      {\n        \"type\": \"mrkdwn\",\n        \"text\": `*Sentimiento:* ${sentimientoBadge} | *Categor\u00eda:* \\`${output.tipo_contenido}\\` | *Temas:* ${output.temas_clave ? output.temas_clave.join(', ') : 'N/A'}`\n      }\n    ]\n  }\n];\n\nif (output.tip_tecnico_faq) {\n  blocks.push({\n    \"type\": \"section\",\n    \"text\": {\n      \"type\": \"mrkdwn\",\n      \"text\": `*\ud83d\udca1 Tip T\u00e9cnico / Soluci\u00f3n:*\\n${output.tip_tecnico_faq}`\n    }\n  });\n}\n\nif (output.post_linkedin) {\n  blocks.push({\n    \"type\": \"section\",\n    \"text\": {\n      \"type\": \"mrkdwn\",\n      \"text\": `*\ud83d\ude80 Post de LinkedIn Sugerido:*\\n>${output.post_linkedin}`\n    }\n  });\n}\n\nreturn [{\n  json: {\n    channel: slackEvent.channel,\n    thread_ts: slackEvent.ts,\n    blocks: blocks,\n    text: output.respuesta_chat\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        340
      ],
      "id": "sk-format-001",
      "name": "Formatear Slack Blocks"
    },
