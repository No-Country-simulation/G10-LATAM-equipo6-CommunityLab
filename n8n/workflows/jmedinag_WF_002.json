      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"CommunityLabAssetOutput\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"sentimiento\": {\n      \"type\": \"string\",\n      \"enum\": [\"positivo\", \"neutro\", \"negativo\"],\n      \"description\": \"Sentimiento del mensaje\"\n    },\n    \"tipo_contenido\": {\n      \"type\": \"string\",\n      \"enum\": [\"logro_contratacion\", \"duda_tecnica\", \"feedback_general\", \"showcase\"],\n      \"description\": \"Categoría de contenido identificada\"\n    },\n    \"temas_clave\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"Lista de tecnologías o conceptos clave identificados\"\n    },\n    \"post_linkedin\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Copy optimizado para LinkedIn si aplica, de lo contrario null\"\n    },\n    \"tip_tecnico_faq\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Respuesta técnica estructurada o FAQ si aplica, de lo contrario null\"\n    }\n  },\n  \"required\": [\n    \"sentimiento\",\n    \"tipo_contenido\",\n    \"temas_clave\",\n    \"post_linkedin\",\n    \"tip_tecnico_faq\"\n  ]\n}"
