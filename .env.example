# LLM Engines (Google Gemini & Groq Cloud)
# Google Gemini API
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-3.6-flash

# Groq Cloud API (Inferencia rápida / Capa gratuita generosa)
GROQ_API_KEY=gsk_tu_groq_api_key_aqui
GROQ_MODEL=openai/gpt-oss-20b

# Oracle Cloud Infrastructure (OCI) Always Free
OCI_USER_OCID=ocid1.user.oc1..aaaaaaa...
OCI_TENANCY_OCID=ocid1.tenancy.oc1..aaaaaaa...
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_KEY_FILE=~/.oci/oci_api_key.pem
OCI_REGION=sa-bogota-1
OCI_NAMESPACE=tu_tenancy_namespace
OCI_BUCKET_NAME=communitylab-activos-marketing

# Discord Integration (Opcional / Simulación)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Configuración de la Aplicación
APP_ENV=development
STREAMLIT_SERVER_PORT=8501

# n8n Orchestrator (OCI VM)
N8N_WEBHOOK_URL=http://147.15.9.116:5678/
N8N_HOST=0.0.0.0
N8N_PORT=5678

# Local n8n Orchestrator
N8N_LOCAL_WEBHOOK_URL=http://localhost:5678/webhook/communitylab-ingesta
N8N_LOCAL_HOST=http://localhost
N8N_LOCAL_PORT=5678

# Logging Detallado del Pipeline (true = DEBUG con trazas a archivo y consola; false = INFO estándar)
ENABLE_DETAILED_LOG=true
LOG_FILE_PATH=logs/communitylab.log

# Dynamic Channels / Interactive Bots (Optional)
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token_aqui
DISCORD_BOT_TOKEN=tu_discord_bot_token_aqui
SLACK_BOT_TOKEN=xoxb-tu_slack_bot_token_aqui
SLACK_APP_TOKEN=xapp-tu_slack_app_token_aqui
