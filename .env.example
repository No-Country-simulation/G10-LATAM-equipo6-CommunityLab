# Oracle Cloud Infrastructure (OCI) Always Free
OCI_USER_OCID=ocid1.user.oc1..aaaaaaaaxxx
OCI_TENANCY_OCID=ocid1.tenancy.oc1..aaaaaaaaxxx
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_KEY_FILE=~/.oci/oci_api_key.pem
OCI_REGION=us-ashburn-1
OCI_NAMESPACE=tu_namespace_aqui
OCI_BUCKET_NAME=communitylab-activos-marketing

# Discord Integration
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/tu_webhook_id/tu_webhook_token_aqui

# Configuracion de la Aplicacion
APP_ENV=development
STREAMLIT_SERVER_PORT=8501
ENABLE_DETAILED_LOG=true
LOG_FILE_PATH=logs/communitylab.log

