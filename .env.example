# Google Gemini API
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-1.5-flash

# Oracle Cloud Infrastructure (OCI) Always Free
OCI_USER_OCID=ocid1.user.oc1..aaaaaaa...
OCI_TENANCY_OCID=ocid1.tenancy.oc1..aaaaaaa...
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_KEY_FILE=~/.oci/oci_api_key.pem
OCI_REGION=sa-bogota-1
OCI_NAMESPACE=tu_tenancy_namespace
OCI_BUCKET_NAME=communitylab-activos-marketing

# Discord Integration (Opcional / Simulación)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Configuración de la Aplicación
APP_ENV=development
STREAMLIT_SERVER_PORT=8501
