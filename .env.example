# ==============================================================================
# ENTORNO DE DESPLIEGUE (PRODUCCION | LOCAL)
# ==============================================================================
ENTORNO_DEPLOY=LOCAL

# LLM Engines (Google Gemini & Groq Cloud)
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-3.6-flash

GROQ_API_KEY=tu_groq_api_key_aqui
