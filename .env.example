# ==============================================================================
# ENTORNO DE DESPLIEGUE (PRODUCCION | LOCAL)
# ==============================================================================
ENTORNO_DEPLOY=LOCAL

# LLM Engines (Google Gemini & Groq Cloud)
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-3.6-flash

GROQ_API_KEY=tu_groq_api_key_aqui
GROQ_MODEL=openai/gpt-oss-20b

# Oracle Cloud Infrastructure (OCI) Always Free
OCI_USER_OCID=ocid1.user.oc1..aaaaaaaaxxx
OCI_TENANCY_OCID=ocid1.tenancy.oc1..aaaaaaaaxxx
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_KEY_FILE=~/.oci/oci_api_key.pem
OCI_REGION=us-ashburn-1
OCI_NAMESPACE=tu_namespace_aqui
OCI_BUCKET_NAME=communitylab-activos-marketing

# Discord Integration
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/tu_webhook_id/tu_webhook_token_aqui

# Configuracion de la Aplicacion
APP_ENV=development
STREAMLIT_SERVER_PORT=8501
ENABLE_DETAILED_LOG=true
LOG_FILE_PATH=logs/communitylab.log

# Motor de Procesamiento Omnicanal (PYTHON | N8N)
# Permite conmutar si los bots en vivo de Telegram, Discord y Slack procesan
# mediante el SDK nativo de Python con Gemini o se despachan a los Webhooks de n8n.
CHANNEL_PROCESSING_ENGINE=PYTHON

# Iniciar bots automáticamente al arrancar la aplicación (true | false)
AUTOSTART_BOTS=true

# ==============================================================================
# SEGURIDAD: CONTROL DE MODIFICACIÓN DE VARIABLES (UI SETTINGS)
# ==============================================================================
SETTINGS_ADMIN_KEY=communitylab2026

# ==============================================================================
# TOGGLES DE CANALES Y PROCESAMIENTO (UI SETTINGS)
# ==============================================================================
TELEGRAM_ENABLED=true
DISCORD_ENABLED=true
SLACK_ENABLED=true
PROCESSING_PYTHON_ENABLED=true
PROCESSING_N8N_ENABLED=false
# ==============================================================================
# PRODUCCION: n8n Orchestrator (OCI VM)
# ==============================================================================
N8N_WEBHOOK_URL=http://147.15.9.116:5678/webhook/communitylab-ingesta
N8N_HOST=0.0.0.0
N8N_PORT=5678

# PRODUCCION: Dynamic Channels / Interactive Bots (Optional)
TELEGRAM_BOT_TOKEN=produccion_telegram_bot_token_aqui
DISCORD_BOT_TOKEN=produccion_discord_bot_token_aqui
SLACK1_BOT_TOKEN=xoxb-produccion_slack1_bot_token_aqui
SLACK1_APP_TOKEN=xapp-produccion_slack1_app_token_aqui
SLACK2_BOT_TOKEN=xoxb-produccion_slack2_bot_token_aqui
SLACK2_APP_TOKEN=xapp-produccion_slack2_app_token_aqui

# ==============================================================================
# LOCAL: n8n Orchestrator
# ==============================================================================
N8N_LOCAL_WEBHOOK_URL=http://localhost:5678/webhook/communitylab-ingesta
N8N_LOCAL_HOST=http://localhost
N8N_LOCAL_PORT=5678
N8N_LOCAL_WEBHOOK_BASE=http://localhost:5678/

# ==============================================================================
# LOCAL: Dynamic Channels / Interactive Bots (Optional)
# ==============================================================================
TELEGRAM_LOCAL_BOT_TOKEN=tu_telegram_bot_token_aqui
DISCORD_LOCAL_BOT_TOKEN=tu_discord_bot_token_aqui

# Slack App 1: Python Puro (Socket Mode)
SLACK1_LOCAL_BOT_TOKEN=xoxb-tu_slack1_bot_token_aqui
SLACK1_LOCAL_APP_TOKEN=xapp-tu_slack1_app_token_aqui

# Slack App 2: n8n Nativo (Webhook)
SLACK2_LOCAL_BOT_TOKEN=xoxb-tu_slack2_bot_token_aqui
SLACK2_LOCAL_APP_TOKEN=xapp-tu_slack2_app_token_aqui

# Tunel Ngrok (Opcional)
NGROK_AUTHTOKEN=tu_ngrok_authtoken_aqui
